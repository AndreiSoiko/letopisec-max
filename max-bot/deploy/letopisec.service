[Unit]
Description=Letopisec MAX Bot
After=network.target postgresql.service

[Service]
Type=simple
User=letopisec-max
WorkingDirectory=/opt/letopisec/max-bot
EnvironmentFile=/opt/letopisec/max-bot/.env
ExecStart=/opt/letopisec/max-bot/venv/bin/python -m bot.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
