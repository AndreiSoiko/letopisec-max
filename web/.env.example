# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.ru www.yourdomain.ru

# База данных (та же, что и у бота) — локальный PostgreSQL на этой же ВМ
DB_NAME=transcription_bot_max
DB_USER=bot
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
# SSL не нужен для локального подключения (было "require" для управляемого кластера)
DB_SSLMODE=disable

# VK OAuth — получить на https://dev.vk.com/
VK_APP_ID=
VK_APP_SECRET=

# Yandex OAuth — получить на https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# T-Bank (те же ключи, что и у бота)
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=
TINKOFF_WEB_NOTIFICATION_URL=https://yourdomain.ru/billing/tinkoff-notify/
TINKOFF_SUCCESS_URL=https://yourdomain.ru/billing/success/
TINKOFF_FAIL_URL=https://yourdomain.ru/billing/fail/

# Тарифы (должны совпадать с конфигом бота)
PRICE_PER_MINUTE_RUB=4
SUBSCRIPTION_PRICE_RUB=300
SUBSCRIPTION_MINUTES=600
